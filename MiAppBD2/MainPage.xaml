<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiAppBD2.MainPage"
             Title="Mis Tareas Offline">

    <Grid RowDefinitions="Auto, *">
        <!-- Botón Superior -->
        <Button Grid.Row="0" Text="+ Nueva Tarea" Clicked="OnNuevaTareaClicked" Margin="10" BackgroundColor="Blue"/>

        <!-- Lista de Tareas -->
        <CollectionView Grid.Row="1" x:Name="listaTareas" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,5" Padding="10" StrokeShape="RoundRectangle 12" StrokeThickness="2">
                        <Grid ColumnDefinitions="10, *, Auto, Auto" ColumnSpacing="10">

                            <!-- NUEVO: Barra vertical que se pinta con el color de la base de datos -->
                            <BoxView Grid.Column="0" 
                                     BackgroundColor="{Binding ColorCategoria}" 
                                     WidthRequest="10" 
                                     CornerRadius="5"/>

                            <!-- Datos -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Titulo}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding FechaLimite, StringFormat='Límite: {0}'}" TextColor="Gray" />
                                <Label Text="{Binding NombreCategoria}" TextColor="{Binding ColorCategoria}" FontAttributes="Bold" FontSize="12" />
                            </VerticalStackLayout>

                            <!-- Botón Editar -->
                            <Button Grid.Column="2" Text="✏️" CommandParameter="{Binding .}" Clicked="OnEditarClicked" BackgroundColor="LightGoldenrodYellow" Margin="5,0" BorderColor="Yellow"/>

                            <!-- Botón Eliminar -->
                            <Button Grid.Column="3" Text="🗑️" CommandParameter="{Binding .}" Clicked="OnEliminarClicked" BackgroundColor="LightCoral" BorderColor="Red"/>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

